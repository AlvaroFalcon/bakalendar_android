<resources>
    <!-- Base application theme. -->
    <style name="Theme.Bakalendar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorPrimaryVariant">@color/main_background</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/main_background</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" >?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>
    <!-- Translucent so the list shows through while the detail is dragged down to close. -->
    <style name="Theme.Bakalendar.Detail">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="DetailExpandedTitle" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DetailCollapsedTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="DetailSectionTitle">
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Searching" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textColor">@color/black</item>
    </style>




    <style name="AppTabLayout" parent="Widget.Material3.TabLayout">
        <item name="tabIndicatorColor">@color/tab_selected_color</item>
        <item name="tabIndicatorHeight">4dp</item>
        <item name="tabMinWidth">90dp</item>
        <item name="tabPaddingStart">6dp</item>
        <item name="tabPaddingEnd">6dp</item>
        <item name="tabSelectedTextColor">@color/tab_selected_color</item>
        <item name="tabTextAppearance">@style/TabTextAppearance</item>
    </style>

    <style name="GenreFilterChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/genre_filter_chip_background</item>
        <item name="android:textColor">@color/white</item>
        <item name="chipCornerRadius">13dp</item>
        <item name="chipMinHeight">30dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="rippleColor">@color/tab_unselected_color</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Body2</item>
    </style>

    <!-- Chips on the white filters sheet. -->
    <style name="SheetFilterChip" parent="GenreFilterChip">
        <item name="chipBackgroundColor">@color/sheet_chip_background</item>
        <item name="android:textColor">@color/sheet_chip_text</item>
    </style>

    <style name="FilterSectionTitle">
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/textInputLayoutHint</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="textAllCaps">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>